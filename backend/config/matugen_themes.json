    "entries": [
        {
            "id": "gtk3",
            "title": "GTK 3",
            "category": "Desktop & system",
            "desc": "Colours for GTK 3 applications",
            "blocks": [
                {
                    "id": "gtk3",
                    "remote": "templates/gtk-colors.css",
                    "input": "{templates}/gtk-colors.css",
                    "output": "{HOME}/.config/gtk-3.0/colors.css",
                    "post_hook": "bash -c 'gsettings set org.gnome.desktop.interface gtk-theme \"\"; if [ \"{{mode}}\" = \"dark\" ]; then gsettings set org.gnome.desktop.interface gtk-theme \"adw-gtk3-dark\"; else gsettings set org.gnome.desktop.interface gtk-theme \"adw-gtk3\"; fi'"
                }
            ],
            "toggle": "templateGtk3",
            "note": "Needs @import 'colors.css' in gtk.css",
            "remove_hook": "T=$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null); if [ -n \"$T\" ]; then gsettings set org.gnome.desktop.interface gtk-theme \"\"; gsettings set org.gnome.desktop.interface gtk-theme \"$T\"; fi"
        },
        {
            "id": "gtk4",
