#!/usr/bin/env bash
# solstice — command-line control for the solstice quickshell.
set -u

QS_BIN="${SOLSTICE_QS:-}"
if [[ -z "$QS_BIN" ]]; then
    if command -v quickshell >/dev/null 2>&1; then
        QS_BIN=quickshell
    elif command -v qs >/dev/null 2>&1; then
        QS_BIN=qs
    else
        echo "solstice: quickshell binary not found (set SOLSTICE_QS)" >&2
        exit 127
    fi
fi
INSTANCE="${SOLSTICE_INSTANCE:-solstice}"

# Repo root (resolves the ~/.local/bin/solstice symlink) — used for logs/.
# This file lives in backend/scripts/, so the root is two levels up.
SRC="${BASH_SOURCE[0]}"
while [[ -L "$SRC" ]]; do
    link="$(readlink "$SRC")"
    case "$link" in
        /*) SRC="$link" ;;
        *)  SRC="$(dirname "$SRC")/$link" ;;
    esac
done
SOLSTICE_ROOT="$(cd "$(dirname "$SRC")/../.." && pwd)"
LOG_DIR="$SOLSTICE_ROOT/logs"
ERROR_LOG="$LOG_DIR/errors.log"
STARTUP_LOG="$LOG_DIR/startup.log"

PANELS="calendar systemtray settings launcher power screenshot"
ACTIONS="toggle open close"
SECTIONS="wallpaper network bluetooth audio global umbriel panels apps about setup"

ensure_logs() { mkdir -p "$LOG_DIR"; }

# GPU / rendering tuning for NVIDIA + VSync off + hardware rendering.
# backend/config/gpu.conf is user-editable and survives updates (install.sh
# keeps backend/config/). Sourced first so any value set there wins; the
# ${VAR:=default} exports below only fill in what is still unset, so values
# exported in the calling environment also win.
GPU_CONF="$SOLSTICE_ROOT/backend/config/gpu.conf"
if [[ -f "$GPU_CONF" ]]; then
    # shellcheck source=/dev/null
    . "$GPU_CONF"
fi

# threaded render loop: decouples QML from rasterization. Qt may fall back to
# the basic loop (single GUI-thread sync+render), which stutters on NVIDIA.
export QSG_RENDER_LOOP="${QSG_RENDER_LOOP:=threaded}"
# OpenGL is the stable RHI path on the NVIDIA proprietary driver; the Vulkan
# backend has swapchain/present quirks. Never let it fall back to software.
export QSG_RHI_BACKEND="${QSG_RHI_BACKEND:=opengl}"
export QT_OPENGL="${QT_OPENGL:=desktop}"
# VSync off. __GL_SYNC_TO_VBLANK is the NVIDIA/X11 switch, vblank_mode the Mesa
# twin. NOTE: in a Wayland session presentation is owned by the compositor, so
# these only take effect for X11/XWayland clients there.
export __GL_SYNC_TO_VBLANK="${__GL_SYNC_TO_VBLANK:=0}"
export vblank_mode="${vblank_mode:=0}"
# NVIDIA's driver busy-waits on the GPU when VSync is off, pegging one core at
# 100%; USLEEP parks it instead.
export __GL_YIELD="${__GL_YIELD:=USLEEP}"

# Frame pacing (Settings > Setup > Experimental > Debug). backend/config/
# debug.json is the single source; the QSG_* pacing variables must exist
# before Qt initializes, so the launcher translates the setting into the
# environment of the shell process:
#   fpsCap "60"       -> QSG_FIXED_ANIMATION_STEP=1
#                        fixed-step driver, hard 60 FPS software cap
#   fpsCap "display"  -> QSG_USE_SIMPLE_ANIMATION_DRIVER=1
#                        elapsed-time driver; the default Qt driver is pinned
#                        to 60 Hz on Wayland (QWaylandScreen reports no
#                        refresh rate), while this one advances by elapsed
#                        time and is throttled by the compositor's frame
#                        callbacks, i.e. the output's highest refresh rate.
#                        This is the hard cap at the display rate (144 on
#                        the 144 Hz output, 60 on the 60 Hz one). Any other
#                        legacy value (e.g. the old "uncapped") falls back to
#                        "display"; true still means "60".
# A value from gpu.conf or the calling environment always wins (we only fill
# in what is still unset).
apply_frame_pacing() {
    [[ -n "${QSG_USE_SIMPLE_ANIMATION_DRIVER:-}" || -n "${QSG_FIXED_ANIMATION_STEP:-}" ]] && return
    local conf="$SOLSTICE_ROOT/backend/config/debug.json"
    [[ -f "$conf" ]] || return
    local cap
    cap="$(jq -r 'if has("fpsCap") then .fpsCap else "display" end' "$conf" 2>/dev/null)"
    if [[ "$cap" == "60" || "$cap" == "true" ]]; then
        export QSG_FIXED_ANIMATION_STEP=1
    else
        export QSG_USE_SIMPLE_ANIMATION_DRIVER=1
    fi
}

boot_shell() {
    ensure_logs
    apply_frame_pacing
    {
        printf '[%s] starting %s\n' "$(date '+%F %T')" "$QS_BIN"
        printf '  QSG_RENDER_LOOP=%s QSG_RHI_BACKEND=%s QT_OPENGL=%s\n' \
            "$QSG_RENDER_LOOP" "$QSG_RHI_BACKEND" "$QT_OPENGL"
        printf '  __GL_SYNC_TO_VBLANK=%s vblank_mode=%s __GL_YIELD=%s\n' \
            "$__GL_SYNC_TO_VBLANK" "$vblank_mode" "$__GL_YIELD"
        printf '  QSG_USE_SIMPLE_ANIMATION_DRIVER=%s QSG_FIXED_ANIMATION_STEP=%s QSG_NO_VSYNC=%s\n' \
            "${QSG_USE_SIMPLE_ANIMATION_DRIVER:-}" "${QSG_FIXED_ANIMATION_STEP:-}" "${QSG_NO_VSYNC:-}"
    } >>"$STARTUP_LOG"
    # --no-duplicate: if another instance of this config is already running
    # (even one started via -p), exit instead of fighting it over the
    # notification server / polkit agent DBus names.
    "$QS_BIN" --no-color --no-duplicate -d -c "$INSTANCE" >>"$STARTUP_LOG" 2>&1
}

call() {
    local target="$1" func="$2"
    shift 2
    "$QS_BIN" ipc -c "$INSTANCE" call "$target" "$func" "$@" 2>&1
}

is_running() {
    "$QS_BIN" list -c "$INSTANCE" 2>/dev/null | grep -q "Process ID"
}

panel_description() {
    case "$1" in
        calendar)   echo "Calendar popout" ;;
        systemtray) echo "System tray" ;;
        settings)   echo "Settings window ('open' takes a section)" ;;
        launcher)   echo "App launcher (opens centred under the bar)" ;;
        power)      echo "Power menu" ;;
        screenshot) echo "Screenshot region / window / fullscreen pill" ;;
    esac
}

lifecycle_description() {
    case "$1" in
        start)   echo "Start the shell in the background. Does nothing if it is already running." ;;
        stop)    echo "Stop the running shell." ;;
        reload)  echo "Reload the shell config. Starts the shell if it is not running." ;;
        restart) echo "Stop and start the shell, re-reading backend/config/gpu.conf." ;;
        state)   echo "Print the open/closed state of every panel." ;;
        lock)    echo "Lock the session. Falls back to loginctl when the shell is not running." ;;
    esac
}

module_call() {
    local module="$1" action="${2:-toggle}" extra="${3:-}"

    case " $PANELS " in
        *" $module "*) ;;
        *)  echo "solstice: unknown panel '$module'" >&2
            echo "Valid panels: $PANELS" >&2
            echo "Run 'solstice panels' for a description of each." >&2
            exit 2 ;;
    esac

    case " $ACTIONS " in
        *" $action "*) ;;
        *)  echo "solstice: unknown action '$action' for panel '$module'" >&2
            echo "Valid actions: $ACTIONS" >&2
            echo "Run 'solstice help module' for help." >&2
            exit 2 ;;
    esac

    case "$module" in
        calendar)
            case "$action" in
                toggle) call solstice toggleCalendar ;;
                open)   call solstice showCalendar ;;
                close)  call solstice hideCalendar ;;
            esac ;;
        systemtray)
            case "$action" in
                toggle) call solstice toggleSystemTray ;;
                open)   call solstice showSystemTray ;;
                close)  call solstice hideSystemTray ;;
            esac ;;
        settings)
            case "$action" in
                toggle) call solstice toggleSettings ;;
                open)   call solstice showSettings "${extra:-global}" ;;
                close)  call solstice hideSettings ;;
            esac ;;
        launcher)
            # true = centred under the bar (SUPER+SPACE); the bar icon opens
            # the panel anchored to itself via the shell's own click path.
            case "$action" in
                toggle) call solstice toggleLauncher true ;;
                open)   call solstice showLauncher true ;;
                close)  call solstice hideLauncher ;;
            esac ;;
        power)
            # Android-style power menu (SUPER+ESCAPE).
            case "$action" in
                toggle) call solstice togglePower ;;
                open)   call solstice showPower ;;
                close)  call solstice hidePower ;;
            esac ;;
        screenshot)
            # Bottom pill for region / window / fullscreen capture (PRINT).
            case "$action" in
                toggle) call solstice toggleScreenshot ;;
                open)   call solstice showScreenshot ;;
                close)  call solstice hideScreenshot ;;
            esac ;;
    esac
}

usage() {
    cat <<EOF
solstice — control the Solstice quickshell from the terminal.

Usage
  solstice <command> [arguments]

Shell
  start                         Start the shell in the background
  stop                          Stop the shell
  reload                        Reload the config (starts it if stopped)
  restart                       Stop and start the shell (re-reads gpu.conf)
  state                         Show which panels are currently open
  lock                          Lock the session / show the lockscreen

Panels
  module <panel> <action>       Open, close or toggle a panel
                                  panels:  $PANELS
                                  actions: $ACTIONS  (default: toggle)
  panels                        List the panels and what they do

Logs
  log [n]                       Show the last n lines of errors.log (default 50)
  log -f [n]                    Follow the error log live

Advanced
  call <target> <function> [args]   Send a raw IPC call
  targets                           List every IPC target and function

Help
  help [command]                Show this help, or help for one command

Environment
  SOLSTICE_QS                   quickshell binary (default: quickshell, else qs)
  SOLSTICE_INSTANCE             IPC instance name (default: solstice)

Examples
  solstice module settings open audio
  solstice module launcher toggle
  solstice log -f
  solstice help module
EOF
}

help_topic() {
    case "${1:-}" in
        ""|help|all) usage ;;
        start|stop|reload|restart|state|lock)
            printf 'solstice %s — shell lifecycle.\n\n' "$1"
            printf 'Usage\n  solstice %s\n\n' "$1"
            printf '%s\n' "$(lifecycle_description "$1")"
            ;;
        module)
            cat <<EOF
solstice module — open, close or toggle a panel.

Usage
  solstice module <panel> [action]

Arguments
  panel    one of: $PANELS
  action   $ACTIONS  (default: toggle)

Settings sections for 'solstice module settings open <section>'
  $SECTIONS

Examples
  solstice module launcher toggle
  solstice module settings open audio
  solstice module calendar close

Run 'solstice panels' for a description of each panel.
EOF
            ;;
        panels)
            printf 'Panels controllable with "solstice module <panel> <action>":\n\n'
            for p in $PANELS; do
                printf '  %-12s %s\n' "$p" "$(panel_description "$p")"
            done
            printf '\nActions: %s   (toggle is the default)\n' "$ACTIONS"
            ;;
        log)
            cat <<EOF
solstice log — read the shell's error log.

Usage
  solstice log [n]        Show the last n lines (default 50)
  solstice log -f [n]     Follow the log live

Files
  $ERROR_LOG
      Runtime errors and warnings.
  $STARTUP_LOG
      Output from the most recent 'solstice start'.
EOF
            ;;
        call)
            cat <<EOF
solstice call — send a raw IPC call to the shell.

Usage
  solstice call <target> <function> [arguments]

Use 'solstice targets' to list every target and its functions.
Example
  solstice call dnd toggle
EOF
            ;;
        targets)
            printf 'solstice targets — list every IPC target and its functions.\n\nUsage\n  solstice targets\n'
            ;;
        *)
            echo "solstice: no help for '$1'" >&2
            echo "Run 'solstice help' to see all commands." >&2
            exit 2 ;;
    esac
}

cmd="${1:-help}"
shift || true

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    help_topic "$cmd"
    exit 0
fi

case "$cmd" in
    start)
        if is_running; then
            echo "solstice: already running"
        else
            boot_shell
            echo "solstice: started"
        fi ;;
    stop)
        if is_running; then
            "$QS_BIN" kill -c "$INSTANCE" >/dev/null 2>&1
            # Wait until the process is really gone so an immediate start
            # cannot collide with its notification server / polkit agent.
            for _ in $(seq 1 50); do
                is_running || break
                sleep 0.1
            done
            echo "solstice: stopped"
        else
            echo "solstice: not running"
        fi ;;
    reload)
        if is_running; then
            call solstice reload
        else
            boot_shell
            echo "solstice: started"
        fi ;;
    restart)
        if is_running; then
            "$QS_BIN" kill -c "$INSTANCE" >/dev/null 2>&1
            # Wait until the process is really gone so boot_shell's
            # --no-duplicate check cannot collide with the old instance.
            for _ in $(seq 1 50); do
                is_running || break
                sleep 0.1
            done
        fi
        boot_shell
        echo "solstice: restarted" ;;
    log)
        if [[ ! -f "$ERROR_LOG" ]]; then
            echo "solstice: no error log yet ($ERROR_LOG)" >&2
            exit 1
        fi
        if [[ "${1:-}" == "-f" || "${1:-}" == "--follow" ]]; then
            shift || true
            tail -n "${1:-50}" -f "$ERROR_LOG"
        else
            tail -n "${1:-50}" "$ERROR_LOG"
        fi ;;
    state)
        if is_running; then call solstice state; else echo "solstice: not running"; fi ;;
    lock)
        if is_running; then
            call lockscreen lock
        else
            loginctl lock-session >/dev/null 2>&1 || echo "solstice: not running" >&2
        fi ;;

    module)
        if [[ $# -lt 1 ]]; then
            help_topic module >&2
            exit 2
        fi
        module_call "$1" "${2:-toggle}" "${3:-}" ;;

    panels)  help_topic panels ;;
    call)    call "$@" ;;
    targets) "$QS_BIN" ipc -c "$INSTANCE" show 2>&1 ;;
    help|-h|--help) help_topic "${1:-}" ;;
    *)
        echo "solstice: unknown command '$cmd'" >&2
        echo "Run 'solstice help' to see all commands." >&2
        exit 2 ;;
esac
